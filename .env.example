# Public frontend configuration only. Never put database passwords, secret keys,
# service_role keys, deployment API tokens, or owner capabilities in VITE_* variables.
VITE_COLLABORATION_URL=https://texla-collaboration.YOUR-SUBDOMAIN.workers.dev

# Optional: enables account integration once the SQL migration and Auth providers are configured.
# Copy to .env.local for development.
# Production URL is set in .github/workflows/pages.yml; its public key is a GitHub Actions Variable.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
