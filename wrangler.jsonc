{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "texla-collaboration",
  "main": "server/index.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "vars": { "ALLOWED_ORIGINS": "https://mcjey71-crypto.github.io" },
  "durable_objects": { "bindings": [{ "name": "ROOMS", "class_name": "DocumentRoom" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["DocumentRoom"] }],
  "ratelimits": [{ "name": "CREATION_LIMIT", "namespace_id": "10171", "simple": { "limit": 5, "period": 60 } }],
  "observability": { "enabled": false },
  "env": {
    "test": {
      "vars": { "ALLOWED_ORIGINS": "http://127.0.0.1:5173,http://localhost:5173" },
      "durable_objects": { "bindings": [{ "name": "ROOMS", "class_name": "DocumentRoom" }] },
      "ratelimits": [{ "name": "CREATION_LIMIT", "namespace_id": "10172", "simple": { "limit": 100, "period": 60 } }]
    }
  }
}
