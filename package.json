{
  "name": "texla-docs",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run src",
    "test:e2e": "playwright test",
    "test:latex": "node scripts/check-latex.mjs",
    "collab:dev": "wrangler dev --env test --port 8787 --ip 127.0.0.1",
    "collab:deploy": "wrangler deploy --env=\"\"",
    "collab:check": "tsc -p server/tsconfig.json",
    "test:collaboration": "playwright test --config playwright.collaboration.config.ts",
    "test:accounts": "playwright test --config playwright.accounts.config.ts"
  },
  "dependencies": {
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/libre-caslon-display": "^5.3.0",
    "@fontsource/literata": "^5.3.0",
    "@supabase/supabase-js": "^2.118.0",
    "@tiptap/extension-collaboration": "^3.32.0",
    "@tiptap/extension-collaboration-caret": "^3.32.0",
    "@tiptap/extension-mathematics": "^3.0.0",
    "@tiptap/extension-placeholder": "^3.0.0",
    "@tiptap/extension-table": "^3.32.0",
    "@tiptap/extension-text-align": "^3.0.0",
    "@tiptap/extension-underline": "^3.0.0",
    "@tiptap/react": "^3.0.0",
    "@tiptap/starter-kit": "^3.0.0",
    "citeproc": "^2.4.63",
    "dompurify": "^3.4.17",
    "htmlparser2": "^12.0.0",
    "katex": "^0.16.22",
    "lib0": "^0.2.119",
    "lucide-react": "^0.468.0",
    "mathlive": "^0.111.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "y-prosemirror": "^1.3.7",
    "y-protocols": "^1.0.7",
    "yjs": "^13.6.33"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261027.1",
    "@electric-sql/pglite": "^0.5.12",
    "@playwright/test": "^1.51.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "~5.7.2",
    "vite": "^6.0.5",
    "vitest": "^3.0.0",
    "wrangler": "^4.153.0"
  }
}
